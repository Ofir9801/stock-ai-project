# Copy to .env and fill in. docker-compose reads this file automatically.

# --- AI providers ---
# At least one key is needed for real analysis; with none, the app returns a mock.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# auto (prefer Claude, fall back to OpenAI) | claude | openai
AI_PROVIDER=auto
# Optional model overrides
# CLAUDE_MODEL=claude-opus-4-8
# OPENAI_MODEL=gpt-4o-mini

# --- PostgreSQL (used by docker-compose) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=stockai
# How long a cached analysis stays fresh, in seconds
CACHE_TTL_SECONDS=3600

# --- Local (non-Docker) overrides ---
# When running uvicorn/streamlit directly on the host:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/stockai
# BACKEND_URL=http://127.0.0.1:8000
